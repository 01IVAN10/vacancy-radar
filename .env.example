# Copy to `.env` and adjust. Values below match the local Docker Compose stack.

# local | test | production
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://vacancy_radar:vacancy_radar@localhost:5432/vacancy_radar
# Needed by the Celery worker and Beat. The collector CLI and Alembic run without it.
REDIS_URL=redis://localhost:6379/0

# Kill switch: comma-separated source slugs that are never fetched.
# `dou` stays disabled locally: GitHub Actions already collects it into Neon,
# and DOU's consent allows one request per 30 minutes from the whole project.
DISABLED_SOURCES=dou
