# Copy to `.env` and adjust. Values below match the local Docker Compose stack.

# local | test | production
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://vacancy_radar:vacancy_radar@localhost:5432/vacancy_radar
# Needed by the Celery worker and Beat. The collector CLI and Alembic run without it.
REDIS_URL=redis://localhost:6379/0

# Signs session cookies. Needed by the web app only; at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-local-development-only-0000000000

# Kill switch: comma-separated source slugs that are never fetched.
# `dou` stays disabled locally: GitHub Actions already collects it into Neon,
# and DOU's consent allows one request per 30 minutes from the whole project.
DISABLED_SOURCES=dou

# Telegram bot from @BotFather (see docs/telegram.md). Leave empty to run without
# Telegram: the bot process then exits, and the site cannot link chats.
# The token is needed by the bot and the worker; never commit a real one.
TELEGRAM_BOT_TOKEN=
# The bot's username, with or without @. The web app builds the link with it.
TELEGRAM_BOT_USERNAME=
# Where the site is reached; the bot's replies link to it.
PUBLIC_BASE_URL=http://localhost:8000
